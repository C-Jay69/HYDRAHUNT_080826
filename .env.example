# =============================================================================
# HYDRAHUNT — Environment Variables Template
# Copy this file to .env and populate with your credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Application & Authentication
# -----------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-chars-random-secret"

# Admin Account Provisioning (used by `npm run db:seed-admin`)
ADMIN_EMAIL="admin@hydrahunt.online"
ADMIN_PASSWORD="change-me-strong-password"

# -----------------------------------------------------------------------------
# Database (Neon Postgres or Supabase Postgres)
# -----------------------------------------------------------------------------
# Example Neon URL: postgresql://user:pass@ep-cool-darkness-123456.us-east-2.aws.neon.tech/hydrahunt?sslmode=require
# Example Supabase URL: postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hydrahunt?schema=public"

# -----------------------------------------------------------------------------
# AI Provider (OpenRouter / OpenAI-Compatible)
# -----------------------------------------------------------------------------
OPEN_ROUTER_API_KEY="sk-or-v1-..."
OPEN_ROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPEN_ROUTER_MODEL="deepseek/deepseek-chat"
AI_MODEL="deepseek/deepseek-chat"
AI_STREAM_MODEL="deepseek/deepseek-chat"

# Optional fallback OpenAI-compatible gateway
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

# -----------------------------------------------------------------------------
# Stripe Subscriptions & Billing
# Plans:
#   - Free ("Enter The Hunt")
#   - Mission Pack ($12 one-time strike)
#   - Hunter ($24/mo or $228/yr)
#   - Beastmaster ($59/mo or $588/yr)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_MISSION_PACK="price_mission_pack_id"
STRIPE_PRICE_HUNTER_MONTHLY="price_hunter_monthly_id"
STRIPE_PRICE_HUNTER_YEARLY="price_hunter_yearly_id"
STRIPE_PRICE_BEASTMASTER_MONTHLY="price_beastmaster_monthly_id"
STRIPE_PRICE_BEASTMASTER_YEARLY="price_beastmaster_yearly_id"

# -----------------------------------------------------------------------------
# Redis / Upstash (Queues & Rate Limiting)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://your-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# -----------------------------------------------------------------------------
# Email Magic Links (Resend / SMTP optional)
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="HydraHunt Command <noreply@hydrahunt.ai>"

# -----------------------------------------------------------------------------
# Job Intelligence & Scraping (Optional)
# -----------------------------------------------------------------------------
CHOCODATA_API_KEY=""
CHOCODATA_RATE_LIMIT_RPM="10"
BRIGHTDATA_API_KEY=""
JOBSPY_URL="http://127.0.0.1:3001/scrape"

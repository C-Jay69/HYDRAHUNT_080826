# ============================================================================
# HydraHunt — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ============================================================================

# ----------------------------------------------------------------------------
# Database (Supabase Postgres recommended)
#   Get this from: Supabase Dashboard → Project Settings → Database →
#   Connection string → "URI" (use the one with the `postgresql://` driver).
#   With the Supabase pooler: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   (set connection limit to 1 when using the transaction pooler with Prisma)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# ----------------------------------------------------------------------------
# Auth — session signing. Generate with:  openssl rand -base64 32
# (either AUTH_SECRET or SESSION_SECRET is required)
# ----------------------------------------------------------------------------
AUTH_SECRET="GENERATE_WITH_openssl_rand_base64_32"
# SESSION_SECRET=optional-fallback

# ----------------------------------------------------------------------------
# Admin account
#   ADMIN_EMAILS: comma-separated emails with admin panel + full paywall bypass.
#     Defaults to admin@hydrahunt.online when unset.
#   ADMIN_EMAIL / ADMIN_PASSWORD: used by `npm run db:seed-admin` to create
#     the admin login (one-time provisioning).
# ----------------------------------------------------------------------------
ADMIN_EMAILS=admin@hydrahunt.online
ADMIN_EMAIL=admin@hydrahunt.online
ADMIN_PASSWORD="CHANGE_ME"

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# AI (z-ai-web-dev-sdk)
#   ai.ts builds the client directly from these env vars (baseUrl + apiKey),
#   so a `.z-ai-config` file is NOT required. For OpenRouter:
#     OPEN_ROUTER_API_KEY="sk-or-v1-..."  (lowercase sk-)
#     OPEN_ROUTER_MODEL="deepseek/deepseek-chat"  (a full, concrete model id)
#   Optional overrides: AI_MODEL (non-streaming) / AI_STREAM_MODEL
#   (defaults to OPEN_ROUTER_MODEL). Use a concrete model id — the
#   "openrouter/free" pool is unreliable (safety refusals / empty streams).
# ----------------------------------------------------------------------------
OPEN_ROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPEN_ROUTER_MODEL="deepseek/deepseek-chat"

# ----------------------------------------------------------------------------
# Email (Resend) — for magic link + contact form
#   Get API key from: https://resend.com/api-keys
#   MAIL_FROM must be a verified domain (e.g. HYDRAHUNT <no-reply@hydrahunt.online>)
# ----------------------------------------------------------------------------
SENDER_API_KEY="YOUR_SENDER_API_KEY"
MAIL_FROM=HydraHunt <no-reply@hydrahunt.online>
CONTACT_EMAIL_TO=admin@hydrahunt.online

# ----------------------------------------------------------------------------
# ChocoData Scraper API (freemium tier: 1000 requests/day)
#   Used by /api/jobs/scrape to harvest LinkedIn job listings.
#   Get your key at: https://chocodata.com
#   Endpoint: GET https://api.chocodata.com/api/v1/linkedin/jobsearch
# ----------------------------------------------------------------------------
CHOCODATA_API_KEY="YOUR_CHOCODATA_API_KEY"
# ChocoData job-scrape rate limit (requests per minute, caps daily quota usage)
CHOCODATA_RATE_LIMIT_RPM=10
# Auto-apply defaults to a dry run unless AUTO_APPLY_DRY_RUN=false is set.
AUTO_APPLY_DRY_RUN=true

# ----------------------------------------------------------------------------
# JobSpy micro-service (REALTIME scraping for boards ChocoData can't do)
#   Run:  bash mini-services/jobspy-svc/serve.sh   (or `npm run dev:services`
#         to start it alongside Next.js dev server)
#   Listens on JOBSPY_PORT (default 3001). The /api/jobs/scrape route
#   proxies indeed / glassdoor / zip_recruiter / google requests here.
#   Requires: python3 + `pip install python-jobspy`
#
#   Vercel cannot run this Python worker. Deploy it as a container
#   (see mini-services/jobspy-svc/DEPLOY.md), set JOBSPY_URL to its public
#   /scrape URL, and set JOBSPY_TOKEN to the same shared secret in both
#   the worker and Vercel. The worker binds 127.0.0.1 locally; containers
#   set JOBSPY_HOST=0.0.0.0 and must provide JOBSPY_TOKEN.
# ----------------------------------------------------------------------------
JOBSPY_PORT=3001
JOBSPY_URL=http://127.0.0.1:3001/scrape
# Optional shared secret. Required when JOBSPY_HOST is not loopback.
# JOBSPY_TOKEN=

# ----------------------------------------------------------------------------
# BrightData Datasets API (BATCH BACKFILL for LinkedIn / Indeed / Glassdoor)
#   Used by: POST /api/jobs/backfill (nightly bulk ingestion, NOT realtime)
#   The /api/jobs/backfill route triggers a filtered dataset snapshot, polls
#   until built (minutes), then streams records into JobOpportunity.
#   Run a backfill: npm run jobs:backfill
#   Datasets: gd_lpfll7v5h... (LinkedIn jobs), gd_l4dx9j9s... (Indeed jobs),
#             gd_lpfbbndm1... (Glassdoor jobs)
# ----------------------------------------------------------------------------
BRIGHTDATA_API_KEY="YOUR_BRIGHTDATA_BEARER_TOKEN"

# ----------------------------------------------------------------------------
# Stripe — subscriptions & one-time mission packs
#   Keys: https://dashboard.stripe.com/apikeys
#   Prices: Dashboard → Products → each price → click "..." → Copy price ID (pi_...)
#   Webhook: https://dashboard.stripe.com/webhooks → add endpoint
#            https://YOUR_DOMAIN/api/webhooks/stripe → select checkout.session.completed,
#            invoice.paid, customer.subscription.updated, customer.subscription.deleted
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"
STRIPE_PRICE_MISSION_PACK="price_12.00"
STRIPE_PRICE_HUNTER_MONTHLY="price_24.00"
STRIPE_PRICE_HUNTER_YEARLY="price_228.00"
STRIPE_PRICE_BEASTMASTER_MONTHLY="price_59.00"
STRIPE_PRICE_BEASTMASTER_YEARLY="price_588.00"
# LIFETIME FOUNDER DEAL ONLY APPLIES TO THE FIRST 250
STRIPE_PRICE_LIFETIME_FOUNDER_DEAL="price_599.00"

# AI reliability (optional)
# AI_MODEL=deepseek/deepseek-chat
# AI_STREAM_MODEL=deepseek/deepseek-chat
# AI_FALLBACK_MODEL=
# AI_TIMEOUT_MS=90000
# AI_MAX_RETRIES=2

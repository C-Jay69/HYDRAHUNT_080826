generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  image             String?
  passwordHash      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  activityLog       ActivityLog[]
  careerMaps        CareerMap[]
  payloads          GeneratedPayload[]
  interviewSessions InterviewSession[]
  jobApplications   JobApplication[]
  jobOpportunities  JobOpportunity[]
  jobTargets        JobTarget[]
  profile           Profile?
  resumes           Resume[]
  analyses          ResumeAnalysis[]
  scrapingRuns      ScrapingRun[]
  subscriptions     Subscription[]
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  headline           String?
  bio                String?
  location           String?
  website            String?
  linkedin           String?
  github             String?
  phone              String?
  targetRole         String?
  targetSalary       Int?
  targetLocation     String?
  experience         String?
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Resume {
  id        String           @id @default(cuid())
  userId    String
  title     String           @default("My Resume")
  summary   String?
  isDefault Boolean          @default(false)
  atsScore  Int?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses  ResumeAnalysis[]
  sections  ResumeSection[]
  versions  ResumeVersion[]
}

model ResumeSection {
  id        String   @id @default(cuid())
  resumeId  String
  type      String
  title     String
  content   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model ResumeVersion {
  id        String   @id @default(cuid())
  resumeId  String
  label     String?
  snapshot  String
  notes     String?
  createdAt DateTime @default(now())
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model ResumeAnalysis {
  id                String   @id @default(cuid())
  resumeId          String
  userId            String
  targetRole        String?
  status            String   @default("processing")
  atsScore          Int?
  strengths         String?
  weaknesses        String?
  missingKeywords   String?
  rewrittenBullets  String?
  roleFitAssessment String?
  actionChecklist   String?
  rawResponse       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  resume            Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GeneratedPayload {
  id              String   @id @default(cuid())
  userId          String
  resumeId        String?
  jobDescription  String
  company         String?
  tone            String   @default("confident")
  tailoredSummary String?
  coverLetter     String?
  outreachEmail   String?
  linkedinMessage String?
  talkingPoints   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobTarget {
  id         String        @id @default(cuid())
  userId     String
  company    String
  role       String
  salary     String?
  location   String?
  status     String        @default("intel")
  priority   String        @default("medium")
  jobUrl     String?
  notes      String?
  followUpAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  activities JobActivity[]
  jobNotes   JobNote[]
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobNote {
  id        String    @id @default(cuid())
  targetId  String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  target    JobTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

model JobActivity {
  id        String    @id @default(cuid())
  targetId  String
  action    String
  details   String?
  createdAt DateTime  @default(now())
  target    JobTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
}

model InterviewSession {
  id        String             @id @default(cuid())
  userId    String
  type      String             @default("behavioral")
  status    String             @default("active")
  role      String?
  company   String?
  score     Int?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  InterviewMessage[]
  scores    InterviewScore[]
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterviewMessage {
  id        String           @id @default(cuid())
  sessionId String
  role      String
  content   String
  score     Int?
  feedback  String?
  createdAt DateTime         @default(now())
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model InterviewScore {
  id        String           @id @default(cuid())
  sessionId String
  category  String
  score     Int
  maxScore  Int              @default(10)
  feedback  String?
  createdAt DateTime         @default(now())
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model CareerMap {
  id          String       @id @default(cuid())
  userId      String
  title       String       @default("My Career Map")
  currentRole String?
  targetRole  String?
  timeline    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes       CareerNode[]
}

model CareerNode {
  id          String    @id @default(cuid())
  mapId       String
  type        String
  label       String
  description String?
  status      String    @default("pending")
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  map         CareerMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
}

model JobOpportunity {
  id           String           @id @default(cuid())
  userId       String
  externalId   String?
  title        String
  company      String?
  companyUrl   String?
  location     String?
  jobUrl       String?
  postedDate   String?
  postedLabel  String?
  salary       String?
  companyLogo  String?
  raw          String?
  status       String           @default("new")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([externalId, userId], name: "externalId_userId")
}

model JobApplication {
  id        String         @id @default(cuid())
  userId    String
  jobId     String
  resumeId  String?
  status    String         @default("pending")
  dryRun    Boolean        @default(true)
  sentAt    DateTime?
  details   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  job       JobOpportunity @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScrapingRun {
  id           String   @id @default(cuid())
  userId       String
  keywords     String
  location     String?
  pages        Int      @default(1)
  totalFound   Int?
  requestCount Int?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  category  String
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                 String         @id @default(cuid())
  userId             String
  plan               String         @default("free")
  status             String         @default("active")
  stripeSubId        String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  billingEvents      BillingEvent[]
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BillingEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  eventType      String
  amount         Int?
  currency       String?
  description    String?
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}
